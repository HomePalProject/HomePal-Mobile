{
  "expo": {
    "name": "HomePal",
    "slug": "homepal-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homepal",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-foreground.png",
        "monochromeImage": "./assets/images/icon-foreground.png",
        "backgroundColor": "#2A5347"
      },
      "package": "com.homepal.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F3",
          "image": "./assets/images/splash-icon-light.png",
          "dark": {
            "backgroundColor": "#356859",
            "image": "./assets/images/splash-icon-dark.png"
          },
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "@react-native-google-signin/google-signin/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://homepal.runasp.net/",
      "googleWebClientId": "815260218319-25gl1soin1gf2cavndjoqmtt501dkn1s.apps.googleusercontent.com"
    }
  }
}
