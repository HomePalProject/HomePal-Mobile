  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "required": ["currentPassword", "newPassword", "confirmNewPassword"],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[\\^$*.[\\]{}()?\"!@#%&/\\\\,><':;|_~`]).{8,}$",
            "type": "string"
          },
          "confirmNewPassword": {
            "type": "string"
          }
        }
      },
      "ConfirmEmailRequest": {
        "required": ["userId", "token"],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "ForgotPasswordRequest": {
        "required": ["email"],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "Gender": {
        "type": "integer"
      },
      "GoogleLoginRequest": {
        "required": ["idToken"],
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "required": ["emailOrUsername", "password"],
        "type": "object",
        "properties": {
          "emailOrUsername": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": ["null", "string"]
          },
          "title": {
            "type": ["null", "string"]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          },
          "detail": {
            "type": ["null", "string"]
          },
          "instance": {
            "type": ["null", "string"]
          }
        }
      },
      "RefreshTokenRequest": {
        "required": ["refreshToken"],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "fullName",
          "gender",
          "username",
          "email",
          "password",
          "confirmPassword",
          "birthDate",
          "governorate",
          "city"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "gender": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Gender"
              }
            ]
          },
          "username": {
            "maxLength": 50,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9._-]+$",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[\\^$*.[\\]{}()?\"!@#%&/\\\\,><':;|_~`]).{8,}$",
            "type": "string"
          },
          "confirmPassword": {
            "type": "string"
          },
          "birthDate": {
            "type": ["null", "string"],
            "format": "date"
          },
          "governorate": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "city": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ResendConfirmationEmailRequest": {
        "required": ["email"],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "ResetPasswordRequest": {
        "required": ["email", "token", "newPassword", "confirmNewPassword"],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "newPassword": {
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[\\^$*.[\\]{}()?\"!@#%&/\\\\,><':;|_~`]).{8,}$",
            "type": "string"
          },
          "confirmNewPassword": {
            "type": "string"
          }
        }
      },
      "UpdateProfileRequest": {
        "required": ["fullName", "gender", "birthDate", "governorate", "city"],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "gender": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Gender"
              }
            ]
          },
          "birthDate": {
            "type": ["null", "string"],
            "format": "date"
          },
          "governorate": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "city": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter JWT Bearer token",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ],
  "tags": [
    {
      "name": "Auth"
    }
  ]
}
